{
  "schema": "hackriff.recipe",
  "schema_version": 2,
  "id": "acars",
  "version": 1,
  "name": "ACARS: aircraft messages",
  "description": "Tutorial 3 (ADR-0011 §5.1; T-096 tuned against the T-098 synthetic ACARS fixture — no acarsdec oracle was available, docs/tutorials/03-acars.md records what's still unverified against a real signal). AM carrier, MSK at 2400 Bd on an 1800 Hz audio subcarrier (non-coherent FSK/MSK discriminator, no differential decoding needed — mark/space map straight to bit 1/0). Frames start after SYN SYN SOH (0x16 0x16 0x01) and end at ETX/ETB plus the 16-bit block check, then mode, registration, acknowledgement, label, block id and text, each an 8-bit character: 7 data bits then an odd-parity bit, MSB (parity) first. The block check is CRC-16/XMODEM (poly 0x1021, init 0, not reflected) computed over the pre-parity 7-bit values padded back to 8 bits with the parity position forced to 0, not over the as-sent bytes: `unwrap` keeps the real parity bits for `fields`; a separate `pz`→`crc` branch zeroes them (parity block, `zero`) for the block-check status and the refinement objective.",
  "match": {
    "families": ["am"],
    "freq_hz": [[129000000, 137000000]],
    "bandwidth_hz": [2000, 8000],
    "symbol_rate_bd": [2400, 2400],
    "bursty": true
  },
  "input": {
    "port": "iq",
    "sample_rate_hz": 24000,
    "bandwidth_hz": 8000
  },
  "nodes": [
    { "id": "am", "block": "am_demod", "label": "Envelope → audio" },
    {
      "id": "tone",
      "block": "subcarrier",
      "label": "1800 Hz MSK subcarrier → baseband",
      "params": { "carrier_hz": 1800, "bandwidth_hz": 2400, "output_rate_hz": 12000 }
    },
    {
      "id": "msk",
      "block": "msk_demod",
      "label": "MSK discriminator",
      "params": { "symbol_rate_bd": 2400 }
    },
    {
      "id": "clock",
      "block": "clock_recovery",
      "label": "2400 Bd timing",
      "params": { "symbol_rate_bd": 2400, "pulse": "nrz", "algorithm": "gardner" }
    },
    { "id": "slice", "block": "slicer" },
    {
      "id": "sync",
      "block": "sync_search",
      "label": "SYN SYN SOH … ETX/ETB + block check",
      "params": {
        "mode": "sync-word",
        "sync_word": "0x160116",
        "sync_bits": 24,
        "max_errors": 2,
        "frame_bits": 2048,
        "include_sync": false,
        "terminator": { "words": ["0x83", "0x97"], "bits": 8, "step_bits": 8, "trailer_bits": 16 }
      }
    },
    {
      "id": "unwrap",
      "block": "crc",
      "label": "Strip the block check (real parity bits kept for fields)",
      "params": { "width": 16, "poly": "0x1021", "refin": false, "refout": false, "strip": true }
    },
    { "id": "msg", "block": "fields", "label": "ACARS block fields", "params": { "map": "acars_block" } },
    {
      "id": "pz",
      "block": "parity",
      "label": "Zero each character's parity bit (block-check convention)",
      "inputs": { "in": "sync" },
      "params": {
        "unit_bits": 8,
        "parity": "odd",
        "position": "first",
        "zero": true,
        "span": { "end_trim_bits": 16 }
      }
    },
    {
      "id": "crc",
      "block": "crc",
      "label": "CRC-16/XMODEM block check (status only)",
      "inputs": { "in": "pz" },
      "params": { "width": 16, "poly": "0x1021", "refin": false, "refout": false, "strip": true }
    }
  ],
  "field_maps": {
    "acars_block": {
      "description": "One ACARS block between SOH and the block check, as packed characters (7-bit ASCII + odd parity in the top bit). Text is present when STX follows the block id and runs to the end (its closing ETX/ETB included).",
      "unit": "bytes",
      "fields": [
        { "name": "mode", "type": "ascii", "length": 1, "parity": "odd" },
        { "name": "registration", "type": "ascii", "length": 7, "parity": "odd", "label": "Aircraft registration" },
        { "name": "ack", "type": "ascii", "length": 1, "parity": "odd", "label": "Technical acknowledgement" },
        { "name": "label", "type": "ascii", "length": 2, "parity": "odd", "label": "Message label" },
        { "name": "block_id", "type": "ascii", "length": 1, "parity": "odd" },
        { "name": "stx", "type": "uint", "length": 1, "display": "hex", "label": "STX (0x02) or ETX" },
        {
          "name": "text",
          "type": "ascii",
          "length": "remainder",
          "parity": "odd",
          "condition": { "field": "stx", "eq": 2 },
          "label": "Text (closing ETX/ETB included)"
        }
      ]
    }
  },
  "outputs": [
    { "id": "blocks", "kind": "inspector", "from": "msg" },
    {
      "id": "message",
      "kind": "messages",
      "from": "msg",
      "decode": {
        "frame_model": "acars-block",
        "metadata": ["label", "block_id", "mode"],
        "content": ["registration", "text"]
      }
    },
    { "id": "symbols", "kind": "stage", "from": "clock.out" }
  ],
  "output_policy": { "content_class": "unrestricted" },
  "refine": {
    "objective": { "node": "crc", "metric": "error_rate", "goal": "min" },
    "tune": ["center_hz"]
  }
}
